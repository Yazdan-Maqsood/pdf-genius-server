# ============================================
# PDFGenius Server - Environment Variables
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Limits
MAX_FILE_SIZE=52428800
MAX_FILES_PER_REQUEST=20
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx,ppt,pptx,html

# Paths
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
LOG_DIR=./logs

# PDF Processing
PDF_COMPRESSION_QUALITY=medium
PDF_IMAGE_QUALITY=70
PDF_DPI=300

# Security - CORS
# Development: http://localhost:3000
# Production:  https://your-frontend.vercel.app
# Multiple:    https://a.com,https://b.com
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# LibreOffice Path
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Linux/Mac: soffice
LIBREOFFICE_PATH=soffice